{
  "project": "my-project",
  "roles": {
    "front": {
      "agent": "team:front",
      "owns": [
        "src/ui/*",
        "src/styles/*"
      ],
      "context": "docs/agents/front.md"
    },
    "back": {
      "agent": "team:back",
      "owns": [
        "src/api/*",
        "migrations/*"
      ]
    },
    "database": {
      "agent": "team:database",
      "owns": []
    },
    "designer": {
      "agent": "team:designer",
      "owns": [
        "docs/design/*",
        "src/styles/tokens.css"
      ]
    },
    "ai": {
      "agent": "team:ai",
      "owns": [
        "src/ai/*"
      ]
    },
    "reviewer": {
      "agent": "team:reviewer",
      "owns": []
    },
    "legal": {
      "agent": "legal",
      "owns": [],
      "description": "Repo-specific specialist, defined in .claude/agents/legal.md",
      "model": "opus"
    }
  },
  "gate": {
    "ignore": [
      "*.md",
      "docs/*",
      "openspec/*",
      ".claude/*",
      ".gitignore"
    ],
    "checks": [
      {
        "name": "typecheck",
        "when": [
          "src/*",
          "*.ts",
          "*.tsx",
          "tsconfig.json",
          "package.json"
        ],
        "run": "npx tsc --noEmit --incremental"
      },
      {
        "name": "lint",
        "when": [
          "src/*.ts",
          "src/*.tsx",
          "src/*.js",
          "src/*.jsx"
        ],
        "run": "npx eslint --cache --max-warnings=0 {files}"
      },
      {
        "name": "api",
        "when": [
          "api/*"
        ],
        "cwd": "api",
        "run": "npx eslint --cache {files}"
      }
    ],
    "final": [
      {
        "name": "build",
        "run": "npm run build"
      },
      {
        "name": "tests",
        "run": "npm test"
      }
    ],
    "review": true,
    "reviewMinLines": 40
  },
  "database": {
    "engine": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "composeProject": "my-project-local",
    "service": "db",
    "containerPort": 3306,
    "envFile": "env/.env.local",
    "nameVar": "DB_NAME",
    "userVar": "DB_READONLY_USER",
    "passwordVar": "DB_READONLY_PASSWORD"
  },
  "miniverse": {
    "url": "http://127.0.0.1:4321"
  }
}
