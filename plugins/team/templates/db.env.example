# Read-only credentials for the database agent (db-query), one file per environment:
#   .claude/db.local.env  .claude/db.dev.env  .claude/db.pre.env  .claude/db.prod.env
# Copy this file to the one you need and fill it in. Those copies NEVER go to git:
# .gitignore must contain '.claude/db.*.env', and db-query refuses to run if one is tracked
# or not ignored. The user must have SELECT only (see .claude/db/readonly-user.sql); db-query
# checks its grants on every call. Host and port are in .claude/team.json →
# database.environments.<env>.
DB_NAME=
DB_READONLY_USER=
DB_READONLY_PASSWORD=
